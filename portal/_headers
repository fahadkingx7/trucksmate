# Cloudflare Pages / Netlify: never cache the page itself or the version file.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/portal/
  Cache-Control: no-cache, no-store, must-revalidate
/portal/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/portal/version.json
  Cache-Control: no-cache, no-store, must-revalidate
